# /opt/wacrm/.env — production template for the Hostinger VPS (Docker).
# Copy to .env, fill in, then: chmod 600 .env
# No quotes around values; one KEY=value per line.
#
# [BUILD] = inlined into the bundle by `next build` → changing it needs
#           `docker compose build` again, not just a restart.
# [RUN]   = read at runtime → `docker compose up -d` is enough.

# ============================================================
# Supabase — same project as today (Project Settings → API)
# ============================================================
# [BUILD][required]
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# [BUILD][required] anon / publishable key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [RUN][required] service_role / secret key — bypasses RLS, server only
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Public URL of this deployment
# ============================================================
# [BUILD][required] scheme + host, no trailing slash. Used for invite links and
# as the webhook URL registered on new Evolution instances.
NEXT_PUBLIC_SITE_URL=https://crm.ascentstudio.com.br
# [BUILD][optional] UI language; defaults to pt
NEXT_PUBLIC_APP_LOCALE=pt
# [RUN][optional] comma-separated hostnames allowed in invite links
ALLOWED_INVITE_HOSTS=crm.ascentstudio.com.br

# ============================================================
# Encryption — MUST be the same value as on Vercel (see migration guide)
# ============================================================
# [RUN][required] 64 hex chars. Encrypts AI provider keys, Meta tokens, Meta
# CAPI token and outbound webhook secrets stored in Supabase. A different value
# does not corrupt data, but every stored credential must be re-entered.
ENCRYPTION_KEY=

# ============================================================
# Evolution API (already running on this VPS)
# ============================================================
# [RUN][required] public URL works from inside Docker; no trailing slash
EVOLUTION_API_BASE_URL=https://evolution.ascentstudio.com.br
# [RUN][required] = AUTHENTICATION_API_KEY from /opt/evolution's environment
EVOLUTION_API_KEY=
# [RUN][required whenever Evolution is set] long random string. Sent by
# Evolution in the x-evolution-secret header (also accepts HMAC signatures).
# Generate: openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=
# [RUN][optional] request timeout in ms (default 10000)
# EVOLUTION_API_TIMEOUT_MS=10000

# ============================================================
# Automations scheduler (cron container in compose.yaml)
# ============================================================
# [RUN][required for the cron container] Generate: openssl rand -hex 32
AUTOMATION_CRON_SECRET=

# ============================================================
# AI
# ============================================================
# Provider keys (OpenAI / Anthropic) are entered per account in
# Settings → AI and stored encrypted in Supabase (ai_configs).
# [RUN][optional] fallback used only when an OpenAI config has no stored key
# OPENAI_API_KEY=
# [RUN][optional] defaults: 30000 ms / 20 messages
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20

# [RUN][optional] pharmacy product lookup tool ("buscar_produto") used by the
# AI agent. Both must be set or the tool is disabled.
# PONTE_URL=
# PONTE_API_KEY=

# [RUN][optional] Recompra automática (deploy/RECOMPRA-PONTE.md).
# Account (accounts.id) that receives the PONTE /vendas sales. Unset = no sync.
# REFILL_PONTE_ACCOUNT_ID=
# Server-wide kill switch for real reminder sends. Anything but "true" = dry run.
# REFILL_SENDING_ENABLED=false

# ============================================================
# Meta WhatsApp Cloud API — only if you use the official API, not just Evolution
# ============================================================
# [RUN] Meta for Developers → App Settings → Basic
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# META_APP_ID=
# [RUN][optional] true = don't actually submit templates to Meta
# WHATSAPP_TEMPLATES_DRY_RUN=
